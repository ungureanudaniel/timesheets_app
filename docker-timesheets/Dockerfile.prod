###########
# BUILDER #
###########

# Use Python 3.12 for both stages
FROM python:3.12-slim-bookworm as builder

# Create directory and set permissions first
RUN mkdir -p /usr/src/docker_timesheets && \
    useradd -m builder && \
    chown builder:builder /usr/src/docker_timesheets

# Set work directory
WORKDIR /usr/src/docker_timesheets

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip

# Create and use a builder user
RUN useradd -m builder && \
    chown builder:builder /usr/src/docker_timesheets
USER builder

# Install dependencies in user space
RUN pip install --user --no-warn-script-location \
    flake8==6.0.0 \
    wheel

# Copy requirements and install
COPY --chown=builder:builder . .

# Lint and build wheels
RUN python -m flake8 --ignore=E501,F401,F403,F405,F841 .
RUN python -m pip wheel --no-cache-dir --no-deps --wheel-dir=/usr/src/docker_timesheets/wheels -r requirements.txt

#########
# FINAL #
#########

FROM python:3.12-slim-bookworm

# Create and configure app user
RUN addgroup --system timesheetsadmin && \
    adduser --system --ingroup timesheetsadmin timesheetsadmin

# Set up directories
ENV APP_HOME=/home/docker-timesheets/web
RUN mkdir -p $APP_HOME/staticfiles $APP_HOME/mediafiles
WORKDIR $APP_HOME

# Copy from builder
COPY --from=builder /usr/src/docker-timesheets/wheels /wheels
COPY --from=builder /usr/src/docker-timesheets/requirements.txt .

# Install dependencies
RUN pip install --no-cache /wheels/* && \
    rm -rf /wheels

# Copy project files
COPY . .

# Set permissions
RUN chown -R timesheetsadmin:timesheetsadmin $APP_HOME && \
    chmod -R 755 $APP_HOME/staticfiles $APP_HOME/mediafiles

# Entrypoint setup
COPY ./entrypoint.prod.sh .
RUN sed -i 's/\r$//g' entrypoint.prod.sh && \
    chmod +x entrypoint.prod.sh

# Switch to non-root user
USER timesheetsadmin

# Runtime configuration
ENTRYPOINT ["/home/docker-timesheets/web/entrypoint.prod.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "docker_timesheets.wsgi:application"]