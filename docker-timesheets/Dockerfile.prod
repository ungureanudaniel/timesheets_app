###########
# BUILDER #
###########
FROM python:3.12-slim-bookworm as builder

# Set work directory and create with correct permissions first
RUN mkdir -p /usr/src/app && \
    useradd -m builder && \
    chown builder:builder /usr/src/app

WORKDIR /usr/src/app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Switch to builder user
USER builder

# Upgrade pip first in user space
RUN python -m pip install --user --no-warn-script-location --upgrade pip

# Install Python tools
RUN pip install --user --no-warn-script-location \
    flake8==6.0.0 \
    wheel

# Copy and build
COPY --chown=builder:builder . .

# Lint and build wheels
RUN python -m flake8 --ignore=E501,F401,F403,F405,F841 .
RUN python -m pip wheel --no-cache-dir --no-deps --wheel-dir=/usr/src/app/wheels -r requirements.txt

#########
# FINAL #
#########
FROM python:3.12-slim-bookworm

# Create app user and directories
RUN useradd -m appuser && \
    mkdir -p /app/{staticfiles,mediafiles} && \
    chown -R appuser:appuser /app

WORKDIR /app
USER appuser

# Upgrade pip in final image
RUN python -m pip install --user --no-warn-script-location --upgrade pip

# Copy from builder
COPY --from=builder --chown=appuser:appuser /usr/src/app/wheels /tmp/wheels
COPY --from=builder --chown=appuser:appuser /usr/src/app/requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir --no-warn-script-location --user /tmp/wheels/* && \
    rm -rf /tmp/wheels

# Copy application
COPY --chown=appuser:appuser . .

# Entrypoint
COPY --chown=appuser:appuser entrypoint.prod.sh .
RUN sed -i 's/\r$//g' entrypoint.prod.sh && \
    chmod +x entrypoint.prod.sh

# Healthcheck
HEALTHCHECK --interval=30s --timeout=30s \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Runtime
ENTRYPOINT ["./entrypoint.prod.sh"]
CMD ["gunicorn", "timesheets_main.wsgi:application", "--bind", "0.0.0.0:8000"]